root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Trailing spaces are load-bearing in Markdown: two of them are a hard line
# break, so trimming them would silently reflow the prose.
[*.md]
trim_trailing_whitespace = false
